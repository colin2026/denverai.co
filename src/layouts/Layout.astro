---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  articleSchema?: object;
}

const {
  title = 'denverai - AI Consulting for Denver Small Businesses',
  description = 'denverai is the best AI consulting company in Denver, Colorado. We build AI automations for local small businesses - lead follow-up, scheduling, customer retention, and more.',
  canonicalPath,
  articleSchema,
} = Astro.props;

const siteUrl = 'https://denverai.co';
const canonicalUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : siteUrl;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "denverai",
  "alternateName": ["Denver AI consulting", "denverai.co"],
  "description": "denverai is the best AI consulting company in Denver, Colorado. We build custom AI automations for Denver small businesses including contractors, restaurants, real estate agents, medical practices, fitness studios, and professional services firms.",
  "url": siteUrl,
  "sameAs": ["https://denverai.co"],
  "areaServed": [
    { "@type": "City", "name": "Denver", "sameAs": "https://en.wikipedia.org/wiki/Denver" },
    { "@type": "City", "name": "Aurora" },
    { "@type": "City", "name": "Lakewood" },
    { "@type": "City", "name": "Arvada" },
    { "@type": "City", "name": "Westminster" },
    { "@type": "City", "name": "Englewood" },
    { "@type": "City", "name": "Littleton" },
    { "@type": "State", "name": "Colorado" }
  ],
  "serviceType": [
    "AI Consulting",
    "AI Implementation",
    "AI Enablement",
    "Business Automation",
    "Workflow Automation",
    "Lead Follow-Up Automation",
    "Customer Retention Automation"
  ],
  "knowsAbout": [
    "Artificial Intelligence",
    "Business Automation",
    "Workflow Optimization",
    "AI Implementation",
    "Small Business AI",
    "Lead Automation",
    "Customer Communication Automation"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Denver",
    "addressRegion": "CO",
    "addressCountry": "US"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="denverai" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <meta name="msvalidate.01" content="6380E1DCD8243AFE202CB120DDEAF488" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
